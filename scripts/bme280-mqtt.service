[Unit]
Description=BME280 MQTT Publisher – Observatorio
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bme280-observatory
ExecStart=/home/pi/bme280-observatory/.venv/bin/python sensor/bme280_mqtt.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
